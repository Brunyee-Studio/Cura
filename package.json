{
  "name": "cura",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "commit": "cz"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "24.19.0",
    "@types/shell-quote": "1.7.5",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "lefthook": "2.1.15",
    "oxlint": "1.86.0",
    "semantic-release": "25.0.9",
    "shell-quote": "1.8.4",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
